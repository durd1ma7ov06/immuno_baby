-- ==========================================
-- 3. ASOSIY JADVALLAR
-- ==========================================

CREATE TABLE profiles (
    id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
    role user_role NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    phone VARCHAR(20) UNIQUE,
    emergency_phone VARCHAR(20),
    
    region_id VARCHAR(50) REFERENCES regions(id) ON DELETE SET NULL,
    district_id VARCHAR(50) REFERENCES districts(id) ON DELETE SET NULL,
    neighborhood_id VARCHAR(50), 
    street_address VARCHAR(255),
    
    specialization VARCHAR(100),
    clinic_name VARCHAR(255),
    license_number VARCHAR(100),
    experience_years INTEGER,
    
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE patients (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    parent_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
    neighborhood_id VARCHAR(50), 
    doctor_id UUID REFERENCES profiles(id) ON DELETE SET NULL, 
    
    name VARCHAR(255) NOT NULL,
    birth_date DATE NOT NULL,
    gender gender_type NOT NULL,
    blood_type VARCHAR(5),
    weight_kg NUMERIC(5,2),
    height_cm NUMERIC(5,2),
    avatar TEXT,
    status VARCHAR(20) DEFAULT 'active',
    
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE vaccines (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(100) NOT NULL,
    disease VARCHAR(255),
    protection TEXT,
    side_effects TEXT,
    emoji VARCHAR(10),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE patient_vaccines (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    patient_id UUID REFERENCES patients(id) ON DELETE CASCADE,
    vaccine_name VARCHAR(100) NOT NULL,
    scheduled_date DATE NOT NULL,
    status vaccine_status DEFAULT 'pending',
    completed_date DATE,
    notes TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE appointments (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    doctor_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
    patient_id UUID REFERENCES patients(id) ON DELETE CASCADE,
    appointment_date DATE NOT NULL,
    appointment_time TIME NOT NULL,
    vaccine_name VARCHAR(100),
    type appointment_type DEFAULT 'new',
    status appointment_status DEFAULT 'waiting',
    notes TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
    type notification_type NOT NULL,
    title VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    is_urgent BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- ==========================================
-- 4. ROW LEVEL SECURITY (RLS)
-- ==========================================

ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE patients ENABLE ROW LEVEL SECURITY;
ALTER TABLE vaccines ENABLE ROW LEVEL SECURITY;
ALTER TABLE patient_vaccines ENABLE ROW LEVEL SECURITY;
ALTER TABLE appointments ENABLE ROW LEVEL SECURITY;
ALTER TABLE notifications ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Profile full access to owner" ON profiles
  FOR ALL USING (auth.uid() = id);

CREATE POLICY "Read profiles public" ON profiles
  FOR SELECT USING (true);

CREATE POLICY "Patients full access" ON patients
  FOR ALL USING (auth.uid() IS NOT NULL);

CREATE POLICY "Vaccines are public" ON vaccines
  FOR SELECT USING (true);

CREATE POLICY "Patient vaccines full access" ON patient_vaccines
  FOR ALL USING (auth.uid() IS NOT NULL);

CREATE POLICY "Appointments full access" ON appointments
  FOR ALL USING (auth.uid() IS NOT NULL);

CREATE POLICY "Notifications full access to owner" ON notifications
  FOR ALL USING (auth.uid() = user_id);

-- ==========================================
-- 5. TRIGGERLAR
-- ==========================================

CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_profiles_modtime BEFORE UPDATE ON profiles FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_patients_modtime BEFORE UPDATE ON patients FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_patient_vaccines_modtime BEFORE UPDATE ON patient_vaccines FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_appointments_modtime BEFORE UPDATE ON appointments FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
