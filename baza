-- 1. KENGAYTMALAR VA ENUMLAR
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

CREATE TYPE user_role AS ENUM ('parent', 'doctor');
CREATE TYPE gender_type AS ENUM ('male', 'female');
CREATE TYPE vaccine_status AS ENUM ('completed', 'pending', 'overdue');
CREATE TYPE appointment_type AS ENUM ('new', 'repeat', 'checkup');
CREATE TYPE appointment_status AS ENUM ('waiting', 'in_progress', 'completed', 'cancelled');
CREATE TYPE notification_type AS ENUM ('vaccine', 'checkup', 'info', 'alert');

